# Lead delivery. Without this the site still builds and runs — /api/lead
# logs leads server-side instead of emailing them (graceful no-op).
SENDGRID_API_KEY=

# Search-engine indexing. Defaults to OFF: without this set to exactly "true",
# robots.txt disallows everything and every page carries meta noindex.
# Set it to true ONLY in the Vercel production environment, and only once
# site.config.ts holds real values (no "$XX" rates, no placeholder reviews,
# no placeholder phone) and the real domain is attached.
NEXT_PUBLIC_INDEXABLE=

# Optional. Overrides site.domain for canonical URLs and the sitemap.
# Normally leave blank — previews are noindex, so their canonicals are inert.
NEXT_PUBLIC_SITE_URL=
